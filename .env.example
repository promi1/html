# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABCDEF

# Your numeric Telegram user id (get from @userinfobot). Only this user
# can interact with the bot. Use comma-separated values for multiple admins.
TELEGRAM_ADMIN_IDS=123456789

# --- FunPay ---
# golden_key cookie from your FunPay session.
# Get it: open funpay.com in browser -> DevTools -> Application -> Cookies -> golden_key
FUNPAY_GOLDEN_KEY=

# Optional User-Agent override (defaults to a realistic Chrome UA)
FUNPAY_USER_AGENT=

# --- Proxy ---
# Optional default proxy (overrides DB-stored pool). Format examples:
#   http://user:pass@host:port
#   socks5://user:pass@host:port
FUNPAY_PROXY=

# --- AI ---
# Optional OpenAI API key for AI-assisted descriptions / replies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Storage ---
# Path to SQLite db file (defaults to ./data/bot.db)
DB_PATH=./data/bot.db

# Path for temporary media (uploaded photos before sending)
MEDIA_DIR=./media

# --- Logging ---
LOG_LEVEL=INFO
