# ─── Telegram Bot ────────────────────────────────────────
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789

# ─── Channel (optional, for mandatory subscription) ─────
CHANNEL_ID=@yourchannel
CHANNEL_URL=https://t.me/yourchannel

# ─── Payments ────────────────────────────────────────────
# CryptoBot (https://t.me/CryptoBot → /myapps)
CRYPTOPAY_TOKEN=

# Lolz.live (https://lolz.live/account/api)
LOLZ_TOKEN=
LOLZ_MERCHANT_ID=0
LOLZ_MERCHANT_TOKEN=

# ─── Web Admin Panel ────────────────────────────────────
ADMIN_PASSWORD=change_me_to_secure_password
SECRET_KEY=change-me-to-random-string

# ─── Server ─────────────────────────────────────────────
WEBHOOK_PORT=8080
WEBHOOK_BASE_URL=http://YOUR_SERVER_IP:8080

# ─── Pricing ────────────────────────────────────────────
PRICE_RUB=119

# ─── Database ───────────────────────────────────────────
DB_PATH=/opt/vpnbot/vpnbot.db

# ─── Links (optional) ───────────────────────────────────
RULES_URL=
TUTORIAL_URL=
